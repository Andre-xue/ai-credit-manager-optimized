/* app.wxss */
page {
  --bg: #fafafc;
  --panel: #ffffff;
  --border: #e9e7f2;
  --text: #101828;
  --text-2: #475467;
  --text-3: #98a2b3;
  --primary: #6d28d9;
  --primary-soft: #f3e8ff;
  --green: #067647;
  --green-soft: #ecfdf3;
  --amber: #b54708;
  --amber-soft: #fffaeb;
  --red: #b42318;
  --red-soft: #fef3f2;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
.container { padding: 24rpx 28rpx 60rpx; }
.card {
  background: var(--panel);
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(16,24,40,.05);
}
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.muted { color: var(--text-3); }
.hint { color: var(--text-2); font-size: 24rpx; }
.title { font-size: 30rpx; font-weight: 600; }
.banner {
  display: flex; align-items: flex-start; gap: 16rpx;
  background: #f5f3ff; border: 1rpx solid #ddd6fe;
  border-radius: 28rpx; padding: 24rpx; font-size: 24rpx;
  line-height: 1.6; color: #5b21b6; margin-bottom: 24rpx;
}
.tag {
  display: inline-flex; align-items: center; padding: 4rpx 14rpx;
  border-radius: 24rpx; font-size: 22rpx; font-weight: 500;
}
.tag.green { background: var(--green-soft); color: var(--green); }
.tag.amber { background: var(--amber-soft); color: var(--amber); }
.tag.gray { background: #f3f4f6; color: var(--text-2); }
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 16rpx 30rpx; border-radius: 999rpx; font-size: 26rpx;
  font-weight: 500; border: 1rpx solid var(--border);
}
.btn.primary { background: linear-gradient(120deg, #6d28d9, #9333ea); color: #fff; border-color: transparent; }
.btn.ghost { background: transparent; color: var(--primary); border-color: transparent; }
.progress { height: 14rpx; border-radius: 99rpx; background: var(--border); overflow: hidden; }
.progress-bar { height: 100%; border-radius: 99rpx; }
.empty { text-align: center; padding: 80rpx 40rpx; color: var(--text-3); }
