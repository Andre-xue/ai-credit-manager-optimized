{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Credit Manager",
  "version": "0.1.247",
  "identifier": "com.example.ai-credit-manager",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ..",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 积分管家",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost http://127.0.0.1 https://api.openai.com https://api.anthropic.com https://api.github.com https://github.com https://objects.githubusercontent.com https://wbapp-uxzyxkkqofad4mwe1lca5e.app.workbuddy.host https://www.workbuddy.cn; media-src 'self' blob: data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/acm-biometric-aarch64-apple-darwin"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4N0E2MEIzOTA4QTc4QTMKUldTamVJcVFzMkI2dUN6R01VcG8yUGpkQnVtWVhkeXdzVTMwRUZCdFJZR3R0TnFGMndEdGJ2TC8K",
      "endpoints": [
        "https://github.com/Andre-xue/ai-credit-manager/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
